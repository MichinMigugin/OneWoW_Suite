{
  "folders": [
    {
      "name": "_OneWoW_Offline",
      "path": "_OneWoW_Offline"
    },
    {
      "name": "OneWoW_Suite",
      "path": "OneWoW_Suite"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/_OneWoW_Offline/**": true
    },
    "Lua.workspace.library": [
      "${workspaceFolder:OneWoW_Suite}/.lua-defs"
    ],
    "wowAPI.luals.defineKnownGlobals": false,
    "wowAPI.luals.frameXML": false,
    "Lua.type.weakUnionCheck": true,
    "Lua.runtime.builtin": {
      "basic": "disable",
      "debug": "disable",
      "io": "disable",
      "math": "disable",
      "os": "disable",
      "package": "disable",
      "string": "disable",
      "table": "disable",
      "utf8": "disable"
    },
    "Lua.runtime.version": "Lua 5.1",
    "Lua.diagnostics.disable": [
      "ambiguity-1",
      "cast-local-type",
      "deprecated",
      "duplicate-set-field",
      "inject-field",
      "lowercase-global",
      "missing-fields",
      "missing-parameter",
      "missing-return",
      "need-check-nil",
      "param-type-mismatch",
      "redundant-parameter",
      "unbalanced-assignments",
      "undefined-field",
      "undefined-global"
    ]
  }
}
