<Bindings>
    <Binding name="ONEWOW_SHOPPING_LIST_TOGGLE" category="BINDING_HEADER_ONEWOW_SHOPPING_LIST">
        if OneWoW_ShoppingList_API then
            OneWoW_ShoppingList_API.Toggle()
        end
    </Binding>
    <Binding name="ONEWOW_SHOPPING_LIST_ADD_ITEM" category="BINDING_HEADER_ONEWOW_SHOPPING_LIST">
        if OneWoW_ShoppingList_API then
            OneWoW_ShoppingList_API.Show()
        end
    </Binding>
</Bindings>
